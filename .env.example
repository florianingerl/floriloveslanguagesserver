# Beispiel-Datei fuer die Umgebungsvariablen des Servers.
# Kopiere sie nach .env (lokal) bzw. .env.production (VPS) und traeg die echten
# Werte ein. Diese Datei bleibt im Repository, die echten Dateien nicht.

# Verbindungsstring zur MongoDB (Pflicht)
MONGODB_URL=

# Gmail-API fuer die E-Mail-Verifizierung bei der Registrierung.
# Ohne diese Werte werden Registrierungen ohne E-Mail-Verifizierung angelegt
# (Entwicklungsmodus), damit der Fluss nicht blockiert ist.
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Basis-URL des Frontends fuer den Verifizierungs-Link
# (Standard: https://florianingerl.github.io)
FRONTEND_URL=

# Python fuer Programmieraufgaben. PYTHON_BIN ist optional; ohne Wert wird
# python3 (Linux/Docker) bzw. python (Windows) verwendet.
PYTHON_BIN=

# Harte Grenzen fuer den Python-Kindprozess. Die Standardwerte sind fuer kurze
# Ein-Funktions-Aufgaben ausgelegt und schuetzen den Server vor Endlosschleifen
# und Speicher-Ausreissern.
PYTHON_TIMEOUT_MS=5000
PYTHON_MEMORY_MB=64
PYTHON_CPU_SECONDS=2

# Wie viele Python-Validierungen gleichzeitig laufen duerfen und wie viele
# Anfragen warten. Mehr parallele Prozesse erhoehen den Speicherbedarf.
PYTHON_MAX_CONCURRENT=2
PYTHON_MAX_QUEUE=10

# Java fuer Programmieraufgaben. JAVA_BIN und JAVAC_BIN sind optional; ohne
# Werte werden JAVA_HOME/bin bzw. die ueblichen Namen aus dem PATH verwendet.
JAVA_BIN=
JAVAC_BIN=

# Harte Grenzen fuer javac und java. Die Laufzeit gilt pro Testfall; die
# Standardwerte sind fuer kurze Stream-Aufgaben ausgelegt.
JAVA_COMPILE_TIMEOUT_MS=15000
JAVA_TIMEOUT_MS=5000
JAVA_MEMORY_MB=128

# Java ist speicherintensiver als Python. Standard: nur eine Validierung
# gleichzeitig, weitere Anfragen warten in einer kurzen Warteschlange.
JAVA_MAX_CONCURRENT=1
JAVA_MAX_QUEUE=10

# Racket fuer Programmieraufgaben laeuft ueber die OnlineCompiler.io-API.
# RACKET_API_KEY ist das API-Token aus dem OnlineCompiler.io-Konto; ohne Wert
# lehnt der Runner Racket-Aufgaben mit einer Konfigurationsfehlermeldung ab.
# Alternativ kann eine gitignorierte Datei racket-key.local.json mit dem Inhalt
# {"apiKey":"..."} verwendet werden.
RACKET_API_KEY=
RACKET_API_URL=https://api.onlinecompiler.io/api/run-code-sync/
RACKET_COMPILER=racket-9.3

# Zeitlimit pro Racket-Ausfuehrung. Die API erlaubt hoechstens 30 Sekunden.
RACKET_TIMEOUT_MS=10000
RACKET_MAX_CONCURRENT=1
RACKET_MAX_QUEUE=10
