# Beispiel-Datei fuer die Umgebungsvariablen des Servers.
# Kopiere sie nach .env (lokal) bzw. .env.production (VPS) und traeg die echten
# Werte ein. Diese Datei bleibt im Repository, die echten Dateien nicht.

# Verbindungsstring zur MongoDB (Pflicht)
MONGODB_URL=

# Gmail-API fuer die E-Mail-Verifizierung bei der Registrierung.
# Bleibt als Fallback erhalten. Resend (siehe unten) hat Vorrang, wenn es
# konfiguriert ist. Ohne jegliche Mail-Konfiguration werden Registrierungen
# ohne E-Mail-Verifizierung angelegt (Entwicklungsmodus), damit der Fluss nicht
# blockiert ist.
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Resend (https://resend.com) fuer die E-Mail-Verifizierung. Wird gegenueber
# Gmail bevorzugt, sobald RESEND_API_KEY und RESEND_FROM gesetzt sind.
# RESEND_FROM muss eine bei Resend verifizierte Absenderadresse sein, z.B.
# "Frag Florian <noreply@deine-domain.de>".
RESEND_API_KEY=
RESEND_FROM=
# Optional: andere API-URL oder Zeitlimit (Standard: Resend-API, 15000 ms).
RESEND_API_URL=
RESEND_TIMEOUT_MS=

# Oeffentliche URL dieses Backends. Daraus werden die OAuth-Callback-URLs
# gebaut, z.B. https://14ofbe9.cserverhost.cloud
# (lokal: http://localhost:8080).
SERVER_PUBLIC_URL=

# Login/Registrierung mit Google (Google Cloud Console -> OAuth-Client).
# Autorisierte Weiterleitung:
#   ${SERVER_PUBLIC_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Login/Registrierung mit GitHub (GitHub -> Settings -> Developer settings ->
# OAuth Apps). Callback-URL:
#   ${SERVER_PUBLIC_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: weitere erlaubte Origins fuer den ?returnTo=-Parameter beim
# OAuth-Login (kommagetrennt). Die FRONTEND_URL ist immer erlaubt.
OAUTH_ALLOWED_REDIRECT_ORIGINS=

# Basis-URL des Frontends fuer den Verifizierungs-Link
# (Standard: https://florianingerl.github.io)
FRONTEND_URL=

# Python fuer Programmieraufgaben. PYTHON_BIN ist optional; ohne Wert wird
# python3 (Linux/Docker) bzw. python (Windows) verwendet.
PYTHON_BIN=

# Harte Grenzen fuer den Python-Kindprozess. Die Standardwerte sind fuer kurze
# Ein-Funktions-Aufgaben ausgelegt und schuetzen den Server vor Endlosschleifen
# und Speicher-Ausreissern.
PYTHON_TIMEOUT_MS=5000
PYTHON_MEMORY_MB=64
PYTHON_CPU_SECONDS=2

# Wie viele Python-Validierungen gleichzeitig laufen duerfen und wie viele
# Anfragen warten. Mehr parallele Prozesse erhoehen den Speicherbedarf.
PYTHON_MAX_CONCURRENT=2
PYTHON_MAX_QUEUE=10

# Java fuer Programmieraufgaben. JAVA_BIN und JAVAC_BIN sind optional; ohne
# Werte werden JAVA_HOME/bin bzw. die ueblichen Namen aus dem PATH verwendet.
JAVA_BIN=
JAVAC_BIN=

# Harte Grenzen fuer javac und java. Die Laufzeit gilt pro Testfall; die
# Standardwerte sind fuer kurze Stream-Aufgaben ausgelegt.
JAVA_COMPILE_TIMEOUT_MS=15000
JAVA_TIMEOUT_MS=5000
JAVA_MEMORY_MB=128

# Java ist speicherintensiver als Python. Standard: nur eine Validierung
# gleichzeitig, weitere Anfragen warten in einer kurzen Warteschlange.
JAVA_MAX_CONCURRENT=1
JAVA_MAX_QUEUE=10

# Racket fuer Programmieraufgaben laeuft ueber die OnlineCompiler.io-API.
# RACKET_API_KEY ist das API-Token aus dem OnlineCompiler.io-Konto; ohne Wert
# lehnt der Runner Racket-Aufgaben mit einer Konfigurationsfehlermeldung ab.
# Alternativ kann eine gitignorierte Datei racket-key.local.json mit dem Inhalt
# {"apiKey":"..."} verwendet werden.
RACKET_API_KEY=1c5ec8f544da441cd4144da3b1c5d385
RACKET_API_URL=https://api.onlinecompiler.io/api/run-code-sync/
RACKET_COMPILER=racket-9.3

# Zeitlimit pro Racket-Ausfuehrung. Die API erlaubt hoechstens 30 Sekunden.
RACKET_TIMEOUT_MS=10000
RACKET_MAX_CONCURRENT=1
RACKET_MAX_QUEUE=10

# Prolog fuer Programmieraufgaben laeuft wie Racket ueber die
# OnlineCompiler.io-API (SWI-Prolog, Compiler-ID swipl-10). Der API-Key ist
# im Code hartkodiert und gilt fuer alle Sprachen des Dienstes.
PROLOG_API_URL=https://api.onlinecompiler.io/api/run-code-sync/
PROLOG_COMPILER=swipl-10

# Zeitlimit pro Prolog-Ausfuehrung. Die API erlaubt hoechstens 30 Sekunden.
PROLOG_TIMEOUT_MS=10000
PROLOG_MAX_CONCURRENT=1
PROLOG_MAX_QUEUE=10
